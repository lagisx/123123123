<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" prefWidth="980.0" prefHeight="620.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.boxing.controller.MainController">
    <left>
        <VBox spacing="10.0" styleClass="sidebar">
            <Label text="🥊 BOX PRO" styleClass="logo"/>
            <Button text="Тренировки" styleClass="nav-btn" maxWidth="Infinity" onAction="#showWorkouts"/>
            <Button text="Дневник" styleClass="nav-btn" maxWidth="Infinity" onAction="#showLog"/>
            <Button text="Таймер раундов" styleClass="nav-btn" maxWidth="Infinity" onAction="#showTimer"/>
        </VBox>
    </left>
    <bottom>
        <Label fx:id="statusLabel" styleClass="status"/>
    </bottom>
</BorderPane>
